.health-frame { background-image: url("Animation/Art/SugarLand/UI/UIHealthFrame.png"); -unity-background-scale-mode: scale-to-fit; position: absolute; left: 2%; top: 3%; width: 330px; height: 92px; background-color: #222a36; border-left-width: 6px; border-left-color: #f5b942; border-radius: 14px; padding-left: 92px; justify-content: center; }
.health-track { width: 210px; height: 28px; background-color: #10151e; border-radius: 8px; overflow: hidden; }
.health-fill { background-image: url("Animation/Art/SugarLand/UI/UIHealthBar.png"); -unity-background-scale-mode: stretch-to-fill; width: 100%; height: 100%; background-color: #51d878; border-radius: 8px; }
.portrait { background-image: url("Animation/Art/SugarLand/UI/CharacterPortrait.png"); -unity-background-scale-mode: scale-to-fit; position: absolute; left: 12px; top: 11px; width: 68px; height: 68px; background-color: #3a5264; border-radius: 34px; justify-content: center; align-items: center; border-width: 3px; border-color: #d6e5ed; }
.portrait-label { color: white; font-size: 12px; -unity-font-style: bold; }
.dialogue { position: absolute; left: 10%; right: 10%; bottom: 3%; min-height: 125px; background-color: rgba(24, 29, 42, 0.96); border-width: 3px; border-color: #f5b942; border-radius: 18px; padding: 22px 28px; justify-content: center; }
.dialogue-text { color: white; font-size: 24px; white-space: normal; -unity-font-style: bold; }
.end-screen { position: absolute; left: 0; right: 0; top: 0; bottom: 0; opacity: 0; transition-property: opacity; transition-duration: 1s; transition-timing-function: ease; justify-content: center; align-items: center; }
.lose-screen { background-color: rgba(10, 13, 20, 0.94); }
.win-screen { background-color: rgba(15, 42, 35, 0.94); }
.end-title { color: white; font-size: 46px; -unity-font-style: bold; -unity-text-align: middle-center; }
.end-subtitle { color: #f5cf73; font-size: 26px; margin-top: 14px; -unity-text-align: middle-center; }
