<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="StartScreen.uss" />
    <ui:VisualElement class="menu-root">
        <ui:VisualElement class="menu-card">
            <ui:Label text="ROBOT REPAIR" class="menu-title" />
